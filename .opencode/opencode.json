{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny",
      "**/*.env*": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "./mvnw test*": "allow",
      "./mvnw verify": "allow",
      "./mvnw.cmd test*": "allow",
      "./mvnw.cmd verify": "allow",
      "docker compose*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    },
    "finbank_get_account_balance": "allow",
    "finbank_list_account_movements": "allow",
    "finbank_simulate_transfer_what_if": "allow",
    "list_mcp_resources": "allow",
    "read_mcp_resource": "allow"
  },
  "mcp": {
    "finbank": {
      "type": "local",
      "command": [
        "C:/Users/Veronica Vassallo/AppData/Local/Programs/Python/Python313/python.exe",
        "C:/Book progetti/Progetto AI Agentic con Claude Code/progetto-di-partenza/progetto-di-partenza/finbank-mcp/server.py"
      ],
      "environment": {
        "FINBANK_BASE_URL": "http://localhost:8080",
        "FINBANK_USERNAME": "{env:FINBANK_USERNAME}",
        "FINBANK_PASSWORD": "{env:FINBANK_PASSWORD}"
      },
      "codemode": false
    }
  }
}
